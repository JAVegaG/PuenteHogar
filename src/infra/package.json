{
    "name": "opencollection-infra",
    "version": "1.0.0",
    "description": "AWS CDK infrastructure for the rental platform",
    "private": true,
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "test": "jest",
        "synth": "cdk synth --all",
        "synth:staging": "cdk synth --all -c env=staging",
        "synth:production": "cdk synth --all -c env=production",
        "deploy:staging": "cdk deploy --all -c env=staging --require-approval never",
        "deploy:production": "cdk deploy --all -c env=production --require-approval broadening",
        "diff": "cdk diff --all",
        "diff:staging": "cdk diff --all -c env=staging",
        "diff:production": "cdk diff --all -c env=production",
        "destroy:staging": "cdk destroy --all -c env=staging --force",
        "staging:sleep": "cdk destroy staging-Monitoring staging-Cdn staging-Compute -c env=staging --force",
        "staging:wake": "cdk deploy staging-Compute staging-Cdn staging-Monitoring -c env=staging --require-approval never",
        "bootstrap": "cdk bootstrap"
    },
    "dependencies": {
        "aws-cdk-lib": "^2.175.1",
        "constructs": "^10.4.2"
    },
    "devDependencies": {
        "typescript": "^5.7.3",
        "ts-node": "^10.9.2",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.5",
        "aws-cdk": "^2.175.1"
    }
}