{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "es2020"
        ],
        "declaration": true,
        "strict": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "noImplicitAny": false,
        "noFallthroughCasesInSwitch": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "inlineSourceMap": true,
        "inlineSources": true,
        "experimentalDecorators": true,
        "skipLibCheck": true,
        "outDir": "./cdk.out/ts",
        "rootDir": ".",
        "types": [
            "node",
            "jest"
        ]
    },
    "include": [
        "bin/**/*.ts",
        "lib/**/*.ts",
        "test/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "cdk.out"
    ]
}