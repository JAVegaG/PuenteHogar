{
  "enabled": true,
  "name": "Auto Conventional Commit",
  "description": "Stages all uncommitted changes after each spec task completes, creates a conventional commit, and pushes to the remote repository.",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `git status --short` and `git diff --stat HEAD` to understand what has changed. Then group the changes by domain or concern (e.g. a module, config, docs). For each group, stage the relevant files and create a conventional commit using `git add <files> && git commit -m \"...\"`. Use conventional commit format: feat/fix/chore/docs/refactor/test(scope): description. Keep each commit focused on one concern. Do not create a single big commit for everything unless all changes are trivially related. After all commits are created, push to the remote repository using `git push`. If the current branch has no upstream tracking branch, use `git push -u origin <branch-name>` to set it up."
  }
}
