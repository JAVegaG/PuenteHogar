# Database
DATABASE_URL=

# Redis
REDIS_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Object Storage
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=

# AWS Credentials (resolved automatically by SDK — set explicitly for local dev with LocalStack/MinIO)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# PII Encryption (32-byte hex key for AES-256-CBC)
PII_ENCRYPTION_KEY=

# App
PORT=3000

# CORS — comma-separated list of allowed origins (empty = allow all in dev)
CORS_ORIGINS=
