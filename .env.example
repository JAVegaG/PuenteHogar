# =============================================================================
# Environment Variables
# =============================================================================
#
# LOCAL DEVELOPMENT: All variables below must be set manually in your .env file.
#
# DEPLOYED ENVIRONMENTS (staging/production): Variables marked [CDK-MANAGED]
# are automatically injected by AWS CDK via App Runner configuration.
# You do NOT need to set them manually — they are resolved from AWS resources
# (RDS endpoints, Secrets Manager, S3 bucket names, etc.) at deploy time.
#
# Only variables marked [LOCAL-ONLY] need to be configured for local development.
# =============================================================================

# -----------------------------------------------------------------------------
# Database [CDK-MANAGED in deployed environments]
# In deployed envs: Constructed from RDS endpoint + Secrets Manager credentials
# Locally: Point to your local PostgreSQL instance
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rental_platform

# -----------------------------------------------------------------------------
# Redis [CDK-MANAGED in deployed environments]
# In deployed envs: Resolved from ElastiCache cluster endpoint
# Locally: Point to your local Redis instance
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# JWT Authentication [CDK-MANAGED in deployed environments]
# In deployed envs: Auto-generated and stored in Secrets Manager
# Locally: Set any string for development
# -----------------------------------------------------------------------------
JWT_SECRET=local-dev-jwt-secret-change-me
JWT_EXPIRES_IN=1d

# -----------------------------------------------------------------------------
# Object Storage [CDK-MANAGED in deployed environments]
# In deployed envs: Resolved from S3 bucket construct (bucket name, region)
# Locally: Point to MinIO/LocalStack or leave empty for stub adapter
# -----------------------------------------------------------------------------
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1

# -----------------------------------------------------------------------------
# AWS Credentials [LOCAL-ONLY]
# In deployed envs: NOT needed — App Runner uses IAM instance roles
# Locally: Set explicitly for LocalStack/MinIO or leave empty for stubs
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# PII Encryption [CDK-MANAGED in deployed environments]
# In deployed envs: Auto-generated 32-byte key stored in Secrets Manager
# Locally: Set a 32-byte hex key for AES-256-CBC encryption
# -----------------------------------------------------------------------------
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# -----------------------------------------------------------------------------
# App Configuration [PARTIALLY CDK-MANAGED]
# PORT and NODE_ENV are set by CDK in deployed environments
# CORS_ORIGINS is environment-specific
# -----------------------------------------------------------------------------
PORT=3000
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Frontend URL [CDK-MANAGED in deployed environments]
# In deployed envs: Resolved from CloudFront distribution or App Runner URL
# Locally: Point to your local Next.js dev server
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Backend API URL (used by frontend) [CDK-MANAGED in deployed environments]
# In deployed envs: Resolved from backend App Runner service URL
# Locally: Point to your local NestJS dev server
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
