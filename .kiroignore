Network Trash Folder
Temporary Items
.apdisk

### macOS Patch ###
# iCloud generated files
*.icloud

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Coverage directory used by tools like istanbul
coverage
*.lcov

